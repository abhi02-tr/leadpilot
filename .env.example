NODE_ENV=development

# Web app URL (frontend dev server)
WEB_URL=http://localhost:5173

# API server URL
API_URL=http://localhost:3001

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadpilot

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Encryption key for AI provider credentials (32-byte hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# AI provider configuration
# Options: template (no credentials required), ollama, hosted
AI_DEFAULT_PROVIDER=template

# Ollama (optional, local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hosted AI provider (optional, e.g. OpenAI-compatible)
# HOSTED_AI_API_KEY=
# HOSTED_AI_BASE_URL=https://api.openai.com/v1
# HOSTED_AI_MODEL=gpt-4o-mini

# Lead discovery provider (optional)
# LEAD_PROVIDER=
# LEAD_PROVIDER_API_KEY=

# Import limits
MAX_IMPORT_ROWS=1000
MAX_IMPORT_FILE_SIZE_MB=10

# AI generation quota (per workspace per day)
MAX_AI_GENERATIONS_PER_DAY=50

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_HOUR=1
